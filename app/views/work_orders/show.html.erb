<% content_for :title, @work_order.title %>

<div class="mb-6 flex items-start justify-between">
  <div>
    <p class="text-sm text-slate-500"><%= link_to "Bảo trì", work_orders_path, class: "hover:text-[#124170]" %> / #WO-<%= @work_order.id.to_s.rjust(5, "0") %></p>
    <h1 class="mt-3 text-3xl font-extrabold text-slate-900"><%= @work_order.title %></h1>
  </div>
  <div class="flex gap-2">
    <%= status_badge(@work_order.status_label, @work_order.status_color) %>
    <%= status_badge(@work_order.priority_label, @work_order.priority_color) %>
    <% if can_manage_system? %>
      <%= link_to "Cập nhật", edit_work_order_path(@work_order), class: "rounded-2xl border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-600" %>
    <% end %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="shell-card rounded-3xl border border-slate-200/70 p-6 lg:col-span-2">
    <h2 class="text-lg font-bold text-slate-900">Nội dung</h2>
    <p class="mt-4 whitespace-pre-wrap text-sm text-slate-700"><%= @work_order.description.presence || "Không có mô tả." %></p>
    <% if @work_order.resolution_notes.present? %>
      <div class="mt-6 rounded-2xl bg-emerald-50 p-4 text-sm text-emerald-800">
        <p class="font-semibold">Ghi chú xử lý</p>
        <p class="mt-2 whitespace-pre-wrap"><%= @work_order.resolution_notes %></p>
      </div>
    <% end %>
  </section>

  <aside class="shell-card rounded-3xl border border-slate-200/70 p-6">
    <h2 class="text-lg font-bold text-slate-900">Thông tin</h2>
    <div class="mt-4 space-y-3 text-sm">
      <div class="flex justify-between gap-4"><span class="text-slate-500">Đối tượng</span><%= link_to @work_order.asset.code, asset_path(@work_order.asset), class: "font-semibold text-[#124170]" %></div>
      <div class="flex justify-between gap-4"><span class="text-slate-500">Người báo</span><span class="text-right font-medium"><%= @work_order.reported_by&.full_name || "–" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-slate-500">Người xử lý</span><span class="text-right font-medium"><%= @work_order.assigned_to&.full_name || "–" %></span></div>
      <div class="flex justify-between gap-4"><span class="text-slate-500">Hạn</span><span class="font-medium"><%= vn_date(@work_order.due_on) %></span></div>
      <div class="flex justify-between gap-4"><span class="text-slate-500">Chi phí</span><span class="font-medium"><%= @work_order.cost || "–" %></span></div>
    </div>
  </aside>
</div>
