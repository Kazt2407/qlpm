<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= content_for?(:title) ? "#{yield(:title)} | " : "" %>QLPM</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <style>
    * { font-family: 'Be Vietnam Pro', sans-serif; }
    body { background: linear-gradient(180deg, #f8fafc 0%, #eef6ff 100%); }
    .shell-card { background: rgba(255,255,255,.82); backdrop-filter: blur(14px); box-shadow: 0 10px 35px rgba(15, 23, 42, .08); }
  </style>
</head>
<body class="min-h-screen text-slate-900">
  <div class="flex min-h-screen">
    <aside class="w-72 border-r border-slate-200/80 bg-white/90 px-5 py-6">
      <div class="mb-8">
        <div class="flex items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#124170] text-sm font-bold text-white">QL</div>
          <div>
            <p class="text-sm font-semibold text-slate-900">Quản lý phòng máy</p>
            <p class="text-xs text-slate-500">Asset, room, borrow, schedule</p>
          </div>
        </div>
      </div>

      <nav class="space-y-2">
        <%= link_to root_path, class: nav_link_classes("dashboard") do %>
          <span>Dashboard</span>
        <% end %>

        <%= link_to assets_path, class: nav_link_classes("assets") do %>
          <span>Đối tượng sử dụng</span>
        <% end %>

        <%= link_to borrows_path, class: nav_link_classes("borrows") do %>
          <span>Lịch mượn và trả</span>
        <% end %>

        <% if current_user&.admin? %>
          <%= link_to reports_path, class: nav_link_classes("reports") do %>
            <span>Báo cáo</span>
          <% end %>

          <%= link_to users_path, class: nav_link_classes("users") do %>
            <span>Người dùng</span>
          <% end %>
        <% end %>
      </nav>

      <div class="shell-card mt-8 rounded-3xl border border-slate-200/70 p-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Tổng quan nhanh</p>
        <div class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between">
            <span class="text-slate-500">Assets</span>
            <span class="font-semibold text-slate-900"><%= @sidebar_assets %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-500">Phòng</span>
            <span class="font-semibold text-slate-900"><%= @sidebar_rooms %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-500">Sẵn sàng</span>
            <span class="font-semibold text-emerald-700"><%= @sidebar_active %></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-500">Đang mở</span>
            <span class="font-semibold text-amber-700"><%= @sidebar_open_borrows %></span>
          </div>
        </div>
      </div>

      <div class="mt-auto pt-8">
        <div class="shell-card rounded-3xl border border-slate-200/70 p-4">
          <p class="text-sm font-semibold text-slate-900"><%= current_user.full_name %></p>
          <p class="mt-1 text-xs text-slate-500"><%= current_user.email %></p>
          <div class="mt-3 flex items-center justify-between">
            <%= status_badge(current_user.admin? ? "Admin" : current_user.user_type.capitalize, current_user.admin? ? "blue" : "sky") %>
            <%= button_to "Đăng xuất", logout_path, method: :delete, class: "rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100" %>
          </div>
        </div>
      </div>
    </aside>

    <main class="flex-1 p-8">
      <% flash.each do |type, message| %>
        <% tone = type.to_s == "notice" ? "emerald" : "red" %>
        <div class="mb-6 rounded-2xl px-4 py-3 <%= status_bg(tone) %>">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </div>
</body>
</html>
