<% content_for :title, "Sửa #{@device.code}" %>

<div class="max-w-2xl mx-auto">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <%= link_to "Danh sách thiết bị", devices_path, class: "hover:text-indigo-400 transition-colors" %>
    <span>›</span>
    <%= link_to @device.code, device_path(@device), class: "hover:text-indigo-400 transition-colors" %>
    <span>›</span><span class="text-gray-300">Chỉnh sửa</span>
  </div>

  <div class="bg-[#1a1d2e] card-glow rounded-2xl p-6">
    <h1 class="text-xl font-bold text-white mb-6">Chỉnh sửa: <%= @device.name %></h1>
    <%= render "form", device: @device %>
  </div>
</div>
