<% content_for :title, "Danh sách thiết bị" %>

<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-2xl font-extrabold text-white">Danh sách thiết bị</h1>
    <p class="text-gray-500 text-sm mt-1">Quản lý toàn bộ thiết bị trong hệ thống</p>
  </div>
  <div class="flex gap-3">
    <button class="border border-white/10 text-gray-300 hover:bg-white/5 text-sm px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" stroke-width="2" stroke-linecap="round"/></svg>
      Xuất Excel
    </button>
    <%= link_to new_device_path,
          class: "bg-indigo-600 hover:bg-indigo-500 text-white text-sm px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke-width="2" stroke-linecap="round"/></svg>
      Thêm thiết bị
    <% end %>
  </div>
</div>

<%# ── Filters ──────────────────────────────────────────────── %>
<div class="bg-[#1a1d2e] card-glow rounded-2xl p-5 mb-6">
  <%= form_with url: devices_path, method: :get, local: true, class: "flex gap-4" do |f| %>
    <div class="flex-1 relative">
      <svg class="w-4 h-4 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" stroke-width="2"/><path d="m21 21-4.35-4.35" stroke-width="2" stroke-linecap="round"/></svg>
      <%= f.text_field :q, value: params[:q],
            placeholder: "Tìm theo tên, mã thiết bị...",
            class: "w-full bg-[#0f1117] border border-white/10 text-gray-300 text-sm pl-9 pr-4 py-2.5 rounded-lg focus:outline-none focus:border-indigo-500/50 placeholder-gray-600" %>
    </div>
    <%= f.select :device_type,
          [["Tất cả loại", ""]] + Device::TYPES.map { |t| [t, t] },
          { selected: params[:device_type] },
          class: "bg-[#0f1117] border border-white/10 text-gray-400 text-sm px-3 py-2.5 rounded-lg focus:outline-none focus:border-indigo-500/50" %>
    <%= f.select :room,
          [["Tất cả phòng", ""]] + Device::ROOMS.map { |r| [r, r] },
          { selected: params[:room] },
          class: "bg-[#0f1117] border border-white/10 text-gray-400 text-sm px-3 py-2.5 rounded-lg focus:outline-none focus:border-indigo-500/50" %>
    <%= f.select :status,
          [["Tất cả trạng thái", ""], ["Hoạt động", "active"], ["Đang mượn", "borrowed"], ["Hỏng", "broken"], ["Bảo trì", "maintenance"]],
          { selected: params[:status] },
          class: "bg-[#0f1117] border border-white/10 text-gray-400 text-sm px-3 py-2.5 rounded-lg focus:outline-none focus:border-indigo-500/50" %>
    <%= f.submit "Lọc", class: "bg-indigo-600 hover:bg-indigo-500 text-white text-sm px-4 py-2.5 rounded-lg cursor-pointer transition-colors" %>
  <% end %>
</div>

<%# ── Table ────────────────────────────────────────────────── %>
<div class="bg-[#1a1d2e] card-glow rounded-2xl overflow-hidden">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-white/5 bg-white/[0.02]">
        <th class="text-left px-6 py-4 text-gray-500 font-semibold text-xs uppercase tracking-wider">Mã TB</th>
        <th class="text-left px-6 py-4 text-gray-500 font-semibold text-xs uppercase tracking-wider">Tên thiết bị</th>
        <th class="text-left px-6 py-4 text-gray-500 font-semibold text-xs uppercase tracking-wider">Loại</th>
        <th class="text-left px-6 py-4 text-gray-500 font-semibold text-xs uppercase tracking-wider">Phòng</th>
        <th class="text-left px-6 py-4 text-gray-500 font-semibold text-xs uppercase tracking-wider">Ngày nhập</th>
        <th class="text-left px-6 py-4 text-gray-500 font-semibold text-xs uppercase tracking-wider">Trạng thái</th>
        <th class="text-left px-6 py-4 text-gray-500 font-semibold text-xs uppercase tracking-wider">Thao tác</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-white/5">
      <% if @devices.any? %>
        <% @devices.each do |device| %>
          <tr class="hover:bg-white/[0.02] transition-colors">
            <td class="px-6 py-4 text-indigo-400 font-semibold"><%= device.code %></td>
            <td class="px-6 py-4 text-white font-medium"><%= device.name %></td>
            <td class="px-6 py-4">
              <span class="bg-blue-500/10 text-blue-400 text-xs px-2 py-0.5 rounded-full"><%= device.device_type %></span>
            </td>
            <td class="px-6 py-4 text-gray-400"><%= device.room %></td>
            <td class="px-6 py-4 text-gray-500"><%= vn_date(device.imported_at) %></td>
            <td class="px-6 py-4"><%= status_badge(device.status_label, device.status_color) %></td>
            <td class="px-6 py-4">
              <div class="flex gap-2">
                <%= link_to device_path(device), title: "Chi tiết", class: "text-gray-500 hover:text-indigo-400 transition-colors" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-width="2"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" stroke-width="2"/></svg>
                <% end %>
                <%= link_to edit_device_path(device), title: "Sửa", class: "text-gray-500 hover:text-amber-400 transition-colors" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" stroke-width="2"/></svg>
                <% end %>
                <%= button_to device_path(device), method: :delete,
                      data: { confirm: "Xóa thiết bị #{device.code}?" },
                      title: "Xóa",
                      class: "text-gray-500 hover:text-red-400 transition-colors bg-transparent border-none cursor-pointer" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" stroke-width="2" stroke-linecap="round"/></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="7" class="px-6 py-12 text-center text-gray-600">
            Không tìm thấy thiết bị nào.
            <%= link_to "Thêm thiết bị mới", new_device_path, class: "text-indigo-400 hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%# Pagination footer %>
  <div class="flex items-center justify-between px-6 py-4 border-t border-white/5">
    <p class="text-gray-500 text-sm">
      Hiển thị <%= @total_count %> thiết bị
    </p>
    <% if @total_pages > 1 %>
      <div class="flex gap-1">
        <% (1..@total_pages).each do |p| %>
          <%= link_to p, devices_path(params.permit(:q, :device_type, :room, :status).merge(page: p)),
                class: "w-8 h-8 rounded-lg text-sm flex items-center justify-center transition-colors #{p == @current_page ? 'bg-indigo-600 text-white' : 'bg-white/5 text-gray-400 hover:bg-indigo-600 hover:text-white'}" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
