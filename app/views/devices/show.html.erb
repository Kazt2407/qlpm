<% content_for :title, @device.code %>

<%# Breadcrumb %>
<div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
  <%= link_to "Danh sách thiết bị", devices_path, class: "hover:text-indigo-400 transition-colors" %>
  <span>›</span>
  <span class="text-gray-300"><%= @device.code %></span>
</div>

<div class="grid grid-cols-3 gap-6">

  <%# ── Left: Device info card ──────────────────────────────── %>
  <div class="col-span-1 space-y-5">

    <%# Main card %>
    <div class="bg-[#1a1d2e] card-glow rounded-2xl p-6">
      <div class="flex items-center justify-center w-20 h-20 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 mx-auto mb-4">
        <svg class="w-10 h-10 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <rect x="2" y="3" width="20" height="14" rx="2" stroke-width="1.5"/>
          <path d="M8 21h8M12 17v4" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <h2 class="text-white font-bold text-lg text-center"><%= @device.name %></h2>
      <p class="text-indigo-400 text-sm text-center font-semibold mt-1"><%= @device.code %></p>
      <div class="flex justify-center mt-3">
        <%= status_badge(@device.status_label, @device.status_color) %>
      </div>

      <div class="border-t border-white/5 mt-5 pt-5 space-y-3 text-sm">
        <% [
             ["Phòng",        "#{@device.room}#{@device.desk_number.present? ? ' – Bàn ' + @device.desk_number.to_s : ''}"],
             ["Loại",         @device.device_type],
             ["Thương hiệu",  @device.brand],
             ["Model",        @device.device_name],
             ["Ngày nhập",    vn_date(@device.imported_at)],
             ["Bảo hành đến", vn_date(@device.warranty_until)]
           ].each do |label, value| %>
          <div class="flex justify-between">
            <span class="text-gray-500"><%= label %></span>
            <span class="text-gray-200"><%= value.presence || "–" %></span>
          </div>
        <% end %>
      </div>

      <div class="flex gap-2 mt-5">
        <%= link_to "Chỉnh sửa", edit_device_path(@device),
              class: "flex-1 border border-white/10 text-gray-300 text-xs py-2 rounded-lg hover:bg-white/5 transition-colors text-center" %>
        <%= link_to "Tạo phiếu mượn", new_borrow_path(device_id: @device.id),
              class: "flex-1 bg-indigo-600 hover:bg-indigo-500 text-white text-xs py-2 rounded-lg transition-colors text-center" %>
      </div>
    </div>

    <%# Tech specs (only if any present) %>
    <% if [@device.cpu, @device.ram, @device.storage, @device.os, @device.ip_address].any?(&:present?) %>
      <div class="bg-[#1a1d2e] card-glow rounded-2xl p-5">
        <h3 class="text-white font-semibold mb-4 text-sm">Thông số kỹ thuật</h3>
        <div class="space-y-2.5 text-sm">
          <% [["CPU", @device.cpu], ["RAM", @device.ram], ["Ổ cứng", @device.storage],
              ["OS", @device.os], ["IP Address", @device.ip_address]].each do |label, val| %>
            <% next unless val.present? %>
            <div class="flex justify-between">
              <span class="text-gray-500"><%= label %></span>
              <span class="<%= label == 'IP Address' ? 'text-indigo-400' : 'text-gray-300' %>"><%= val %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# ── Right: History + Notes ──────────────────────────────── %>
  <div class="col-span-2 space-y-5">

    <%# Borrow history timeline %>
    <div class="bg-[#1a1d2e] card-glow rounded-2xl p-6">
      <h2 class="text-white font-bold mb-5 border-b border-white/5 pb-3">Lịch sử mượn – trả</h2>

      <% if @borrow_history.any? %>
        <div class="space-y-4">
          <% @borrow_history.each_with_index do |borrow, idx| %>
            <div class="flex gap-4">
              <div class="flex flex-col items-center">
                <div class="w-8 h-8 rounded-full bg-<%= borrow.status_color %>-500/20 border border-<%= borrow.status_color %>-500/30 flex items-center justify-center shrink-0">
                  <% if borrow.returned_at.present? %>
                    <svg class="w-4 h-4 text-<%= borrow.status_color %>-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2"/></svg>
                  <% else %>
                    <svg class="w-4 h-4 text-<%= borrow.status_color %>-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2" stroke-linecap="round"/></svg>
                  <% end %>
                </div>
                <% unless idx == @borrow_history.size - 1 %>
                  <div class="w-px flex-1 bg-white/5 mt-2"></div>
                <% end %>
              </div>
              <div class="pb-4 flex-1">
                <div class="flex items-center justify-between mb-1">
                  <p class="text-white text-sm font-medium">
                    <%= borrow.returned_at.present? ? "Đã trả" : "Đang mượn" %> – <%= borrow.borrower_name %>
                  </p>
                  <span class="text-gray-500 text-xs"><%= vn_datetime(borrow.borrowed_at) %></span>
                </div>
                <p class="text-gray-500 text-xs">
                  <% if borrow.returned_at.present? %>
                    Trả ngày <%= vn_date(borrow.returned_at) %>.
                    <% if borrow.overdue? %> <span class="text-red-400">Trễ <%= borrow.days_overdue %> ngày.</span><% end %>
                  <% end %>
                  <% if borrow.purpose.present? %>Mục đích: <%= borrow.purpose %><% end %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-600 text-sm text-center py-6">Chưa có lịch sử mượn.</p>
      <% end %>
    </div>

    <%# Notes / warnings %>
    <div class="bg-[#1a1d2e] card-glow rounded-2xl p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-white font-semibold">Ghi chú & cảnh báo</h3>
      </div>

      <%# Warranty warning %>
      <% if @device.warranty_until.present? && @device.warranty_until > Date.today %>
        <% months_left = ((@device.warranty_until.year - Date.today.year) * 12 + @device.warranty_until.month - Date.today.month) %>
        <div class="bg-amber-500/5 border border-amber-500/20 rounded-xl p-4 mb-3">
          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-amber-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke-width="2" stroke-linecap="round"/></svg>
            <div>
              <p class="text-amber-300 text-sm font-medium">Bảo hành còn <%= months_left %> tháng</p>
              <p class="text-gray-500 text-xs mt-0.5">Hết hạn vào <%= vn_date(@device.warranty_until) %>.</p>
            </div>
          </div>
        </div>
      <% end %>

      <% if @device.notes.present? %>
        <div class="bg-blue-500/5 border border-blue-500/20 rounded-xl p-4">
          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-blue-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2"/></svg>
            <div>
              <p class="text-blue-300 text-sm font-medium">Ghi chú</p>
              <p class="text-gray-400 text-xs mt-0.5"><%= @device.notes %></p>
            </div>
          </div>
        </div>
      <% elsif @device.warranty_until.nil? || @device.warranty_until <= Date.today %>
        <p class="text-gray-600 text-sm text-center py-4">Không có ghi chú.</p>
      <% end %>
    </div>
  </div>
</div>
