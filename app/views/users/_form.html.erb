<%= form_with model: user, class: "space-y-5" do |f| %>
  <% if user.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <% user.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= f.label :full_name, "Họ tên", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :full_name, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
    <div>
      <%= f.label :email, "Thư điện tử", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    <div>
      <%= f.label :role, "Vai trò hệ thống", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.select :role, User.role_options, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
    <div>
      <%= f.label :user_type, "Nhóm tài khoản", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.select :user_type, User.user_type_options, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
    <div>
      <%= f.label :active, "Kích hoạt", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.select :active, [["Đang hoạt động", true], ["Vô hiệu hóa", false]], {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= f.label :identifier, "Mã định danh", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :identifier, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
    <div>
      <%= f.label :department, "Đơn vị", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :department, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= f.label :password, user.persisted? ? "Mật khẩu mới (để trống nếu không đổi)" : "Mật khẩu", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.password_field :password, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Xác nhận mật khẩu", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.password_field :password_confirmation, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= link_to "Hủy", users_path, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50" %>
    <%= f.submit user.persisted? ? "Cập nhật" : "Tạo mới", class: "rounded-2xl bg-[#124170] px-4 py-3 text-sm font-semibold text-white hover:bg-[#0d3258]" %>
  </div>
<% end %>
