<% content_for :title, "Người dùng" %>

<div class="mb-8 flex items-start justify-between">
  <div>
    <h1 class="text-3xl font-extrabold text-slate-900">Người dùng và phân quyền</h1>
    <p class="mt-2 text-sm text-slate-500">Quản trị tài khoản, phân quyền và trạng thái hoạt động.</p>
  </div>
  <%= link_to "Thêm người dùng", new_user_path, class: "rounded-2xl bg-[#124170] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#0d3258]" %>
</div>

<div class="shell-card rounded-3xl border border-slate-200/70 p-5">
  <%= form_with url: users_path, method: :get, class: "grid gap-3 md:grid-cols-5" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "Tìm theo tên, thư điện tử, mã...", class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    <%= f.select :role, [["Tất cả vai trò", ""]] + User.role_options, { selected: params[:role] }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    <%= f.select :user_type, [["Tất cả nhóm tài khoản", ""]] + User.user_type_options, { selected: params[:user_type] }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    <%= f.select :active, [["Tất cả trạng thái", ""], ["Đang hoạt động", true], ["Vô hiệu hóa", false]], { selected: params[:active] }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    <%= f.select :sort, [["Tên A-Z", "name_asc"], ["Tên Z-A", "name_desc"], ["Mới tạo", "created_desc"], ["Mới cập nhật", "updated_desc"]], { selected: params[:sort] || "name_asc" }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>

    <div class="md:col-span-5 flex gap-3">
      <%= f.select :per_page, pagination_per_page_options, { selected: selected_per_page_param }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      <%= f.submit "Lọc", class: "rounded-2xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white" %>
    </div>
  <% end %>
</div>

<div class="shell-card mt-6 overflow-hidden rounded-3xl border border-slate-200/70">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-[0.2em] text-slate-500">
      <tr>
        <th class="px-4 py-3">Họ tên</th>
        <th class="px-4 py-3">Thư điện tử</th>
        <th class="px-4 py-3">Vai trò hệ thống</th>
        <th class="px-4 py-3">Nhóm tài khoản</th>
        <th class="px-4 py-3">Trạng thái</th>
        <th class="px-4 py-3">Thao tác</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 bg-white">
      <% @users.each do |user| %>
        <tr>
          <td class="px-4 py-3">
            <div class="font-semibold text-slate-900"><%= user.full_name %></div>
            <div class="text-xs text-slate-500"><%= user.department.presence || "–" %></div>
          </td>
          <td class="px-4 py-3 text-slate-600"><%= user.email %></td>
          <td class="px-4 py-3"><%= status_badge(user.role_label, user.admin? ? "blue" : "sky") %></td>
          <td class="px-4 py-3 text-slate-600"><%= user.user_type_label %></td>
          <td class="px-4 py-3"><%= status_badge(user.active? ? "Đang hoạt động" : "Ngưng hoạt động", user.active? ? "emerald" : "gray") %></td>
          <td class="px-4 py-3">
            <div class="flex flex-wrap gap-2">
              <%= link_to "Sửa", edit_user_path(user), class: "rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50" %>
              <% if user != current_user %>
                <%= button_to(user.active? ? "Khóa" : "Mở", toggle_active_user_path(user), method: :patch, class: "rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50") %>
                <%= button_to "Đặt lại mật khẩu", reset_password_user_path(user), method: :patch, class: "rounded-xl border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-700 hover:bg-amber-100" %>
                <%= button_to "Xóa", user_path(user), method: :delete, data: { turbo_confirm: "Xóa người dùng này?" }, class: "rounded-xl border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-medium text-rose-700 hover:bg-rose-100" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @users.empty? %>
        <tr>
          <td colspan="6" class="px-4 py-12 text-center text-slate-500">Không có người dùng phù hợp.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "shared/pagination", page: @page, total_pages: @total_pages, total_count: @total_count %>
