<% content_for :title, "Dashboard" %>

<div class="mb-8 flex items-start justify-between">
  <div>
    <h1 class="text-3xl font-extrabold text-slate-900">Vận hành phòng máy</h1>
    <p class="mt-2 text-sm text-slate-500">
      <%= l(Date.current, format: "%A, ngày %d tháng %m năm %Y") %>
    </p>
  </div>
  <% if current_user.admin? %>
    <%= link_to "Thêm đối tượng", new_asset_path, class: "rounded-2xl bg-[#124170] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#0d3258]" %>
  <% else %>
    <%= link_to "Tạo yêu cầu mượn", new_borrow_path, class: "rounded-2xl bg-[#124170] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#0d3258]" %>
  <% end %>
</div>

<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
  <% [
    ["Tổng đối tượng", @total_assets, "Quản lý theo room, computer, device"],
    ["Phòng máy", @total_rooms, "Có thể nhập lịch từ sheet"],
    ["Sẵn sàng", @active_assets, "#{@active_pct}% tổng tài nguyên"],
    ["Đang sử dụng", @borrowed_assets, "#{@maintenance_assets} đang cần xử lý"]
  ].each do |label, value, note| %>
    <div class="shell-card rounded-3xl border border-slate-200/70 p-5">
      <p class="text-sm text-slate-500"><%= label %></p>
      <p class="mt-4 text-4xl font-extrabold text-slate-900"><%= value %></p>
      <p class="mt-3 text-xs text-slate-500"><%= note %></p>
    </div>
  <% end %>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-3">
  <div class="shell-card rounded-3xl border border-slate-200/70 p-6 xl:col-span-2">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="text-lg font-bold text-slate-900">Phân bố asset theo phòng</h2>
      <span class="text-xs uppercase tracking-[0.2em] text-slate-400">room load</span>
    </div>
    <div class="space-y-4">
      <% max_count = [@assets_by_room.map { |row| row[:count] }.max, 1].max %>
      <% @assets_by_room.each do |row| %>
        <div>
          <div class="mb-2 flex items-center justify-between text-sm">
            <span class="font-medium text-slate-700"><%= row[:room] %></span>
            <span class="text-slate-500"><%= row[:count] %> assets</span>
          </div>
          <div class="h-3 rounded-full bg-slate-100">
            <div class="h-3 rounded-full bg-gradient-to-r from-[#124170] to-[#5ea3d6]" style="width: <%= pct_width(row[:count], max_count) %>"></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="shell-card rounded-3xl border border-slate-200/70 p-6">
    <h2 class="text-lg font-bold text-slate-900">Nhóm người mượn</h2>
    <div class="mt-5 space-y-4">
      <% [["Sinh viên", @borrow_mix[:student], "emerald"], ["Giáo viên", @borrow_mix[:teacher], "blue"], ["Hệ thống", @borrow_mix[:system], "amber"]].each do |label, value, color| %>
        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4">
          <div class="flex items-center justify-between">
            <p class="text-sm font-medium text-slate-700"><%= label %></p>
            <%= status_badge("#{value} bản ghi", color) %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="shell-card mt-6 rounded-3xl border border-slate-200/70 p-6">
  <div class="mb-5 flex items-center justify-between">
    <h2 class="text-lg font-bold text-slate-900"><%= current_user.admin? ? "Hoạt động gần đây" : "Yêu cầu của bạn" %></h2>
    <%= link_to "Xem tất cả", borrows_path, class: "text-sm font-medium text-[#124170] hover:underline" %>
  </div>
  <div class="overflow-hidden rounded-2xl border border-slate-200">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase tracking-[0.2em] text-slate-500">
        <tr>
          <th class="px-4 py-3">Asset</th>
          <th class="px-4 py-3">Người mượn</th>
          <th class="px-4 py-3">Khoảng thời gian</th>
          <th class="px-4 py-3">Trạng thái</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        <% if @recent_borrows.any? %>
          <% @recent_borrows.each do |borrow| %>
            <tr>
              <td class="px-4 py-3">
                <div class="font-semibold text-slate-900"><%= borrow.asset.name %></div>
                <div class="text-xs text-slate-500"><%= borrow.asset.code %></div>
              </td>
              <td class="px-4 py-3">
                <div class="text-slate-800"><%= borrow.borrower_name %></div>
                <div class="text-xs text-slate-500"><%= borrow.borrower_group.presence || borrow.borrower_type %></div>
              </td>
              <td class="px-4 py-3 text-slate-600">
                <%= vn_datetime(borrow.starts_at) %><br>
                <span class="text-xs text-slate-400">đến <%= vn_datetime(borrow.ends_at) %></span>
              </td>
              <td class="px-4 py-3"><%= status_badge(borrow.status_label, borrow.status_color) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="px-4 py-10 text-center text-slate-500">Chưa có dữ liệu gần đây.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
