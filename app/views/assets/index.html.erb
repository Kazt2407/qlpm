<% content_for :title, "Đối tượng sử dụng" %>

<div class="mb-8 flex items-start justify-between">
  <div>
    <h1 class="text-3xl font-extrabold text-slate-900">Đối tượng sử dụng</h1>
    <p class="mt-2 text-sm text-slate-500">Quản lý thống nhất phòng máy, máy tính, và thiết bị rời.</p>
  </div>
  <% if current_user.admin? %>
    <%= link_to "Thêm mới", new_asset_path, class: "rounded-2xl bg-[#124170] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#0d3258]" %>
  <% end %>
</div>

<div class="shell-card rounded-3xl border border-slate-200/70 p-5">
  <%= form_with url: assets_path, method: :get, class: "grid gap-3 md:grid-cols-4" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "Tìm theo mã, tên, serial...", class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-[#124170]" %>
    <%= f.select :asset_type, [["Tất cả loại", ""]] + @asset_types.map { |type| [Asset.asset_type_label_for(type), type] }, { selected: params[:asset_type] }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    <%= f.select :category, [["Tất cả nhóm", ""]] + @categories.map { |cat| [Asset.category_label_for(cat), cat] }, { selected: params[:category] }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    <%= f.select :room_id, [["Tất cả phòng", ""]] + @rooms.map { |room| [room.name, room.id] }, { selected: params[:room_id] }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>

    <%= f.select :status, [["Tất cả trạng thái", ""]] + Asset.status_options, { selected: params[:status] }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    <%= f.select :sort, [["Loại + mã", ""], ["Mã A-Z", "code_asc"], ["Mã Z-A", "code_desc"], ["Tên A-Z", "name_asc"], ["Tên Z-A", "name_desc"], ["Mới cập nhật", "updated_desc"]], { selected: params[:sort] }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>

    <div class="flex gap-3 md:col-span-2">
      <%= f.select :per_page, pagination_per_page_options, { selected: selected_per_page_param }, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      <%= f.submit "Lọc", class: "rounded-2xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white" %>
    </div>
  <% end %>
</div>

<div class="shell-card mt-6 overflow-hidden rounded-3xl border border-slate-200/70">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-[0.2em] text-slate-500">
      <tr>
        <th class="px-4 py-3">Mã</th>
        <th class="px-4 py-3">Tên</th>
        <th class="px-4 py-3">Loại</th>
        <th class="px-4 py-3">Phòng</th>
        <th class="px-4 py-3">Trạng thái</th>
        <th class="px-4 py-3">Thao tác</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 bg-white">
      <% @assets.each do |asset| %>
        <tr>
          <td class="px-4 py-3 font-semibold text-[#124170]"><%= asset.code %></td>
          <td class="px-4 py-3">
            <div class="font-semibold text-slate-900"><%= asset.name %></div>
            <div class="text-xs text-slate-500"><%= asset.category_label %></div>
          </td>
          <td class="px-4 py-3 text-slate-600"><%= asset.asset_type_label %></td>
          <td class="px-4 py-3 text-slate-600"><%= asset.room_name || "–" %></td>
          <td class="px-4 py-3"><%= status_badge(asset.status_label, asset.status_color) %></td>
          <td class="px-4 py-3">
            <div class="flex gap-2">
              <%= link_to "Xem", asset_path(asset), class: "rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50" %>
              <% if current_user.admin? %>
                <%= link_to "Sửa", edit_asset_path(asset), class: "rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @assets.empty? %>
        <tr>
          <td colspan="6" class="px-4 py-12 text-center text-slate-500">Không tìm thấy đối tượng phù hợp.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "shared/pagination", page: @page, total_pages: @total_pages, total_count: @total_count %>
