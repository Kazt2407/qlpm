<% content_for :title, "Lịch mượn và trả" %>

<div class="mb-8 flex items-start justify-between">
  <div>
    <h1 class="text-3xl font-extrabold text-slate-900">Lịch mượn và trả</h1>
    <p class="mt-2 text-sm text-slate-500">Theo dõi yêu cầu thủ công, lịch import, và thời gian trả thực tế.</p>
  </div>
  <%= link_to "Tạo phiếu mượn", new_borrow_path, class: "rounded-2xl bg-[#124170] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#0d3258]" %>
</div>

<div class="grid gap-5 md:grid-cols-3">
  <% [["Đang mở", @total_borrowing, "amber"], ["Đã trả tháng này", @total_returned, "emerald"], ["Quá hạn", @total_overdue, "red"]].each do |label, value, color| %>
    <div class="shell-card rounded-3xl border border-slate-200/70 p-5">
      <p class="text-sm text-slate-500"><%= label %></p>
      <div class="mt-4 flex items-center justify-between">
        <p class="text-4xl font-extrabold text-slate-900"><%= value %></p>
        <%= status_badge(label, color) %>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-6 flex gap-2">
  <% [["all", "Tất cả"], ["active", "Đang mở"], ["returned", "Đã trả"], ["overdue", "Quá hạn"]].each do |tab, label| %>
    <%= link_to label, borrows_path(tab: tab), class: "rounded-2xl px-4 py-2 text-sm font-medium #{@active_tab == tab ? 'bg-[#124170] text-white' : 'bg-white text-slate-600 border border-slate-200'}" %>
  <% end %>
</div>

<div class="shell-card mt-6 overflow-hidden rounded-3xl border border-slate-200/70">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-[0.2em] text-slate-500">
      <tr>
        <th class="px-4 py-3">Asset</th>
        <th class="px-4 py-3">Người mượn</th>
        <th class="px-4 py-3">Nguồn</th>
        <th class="px-4 py-3">Thời gian</th>
        <th class="px-4 py-3">Trạng thái</th>
        <th class="px-4 py-3">Thao tác</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 bg-white">
      <% @borrows.each do |borrow| %>
        <tr>
          <td class="px-4 py-3">
            <div class="font-semibold text-slate-900"><%= borrow.asset.name %></div>
            <div class="text-xs text-slate-500"><%= borrow.asset.code %></div>
          </td>
          <td class="px-4 py-3">
            <div class="font-medium text-slate-800"><%= borrow.borrower_name %></div>
            <div class="text-xs text-slate-500"><%= borrow.borrower_group.presence || borrow.borrower_type %></div>
          </td>
          <td class="px-4 py-3 text-slate-600"><%= borrow.borrow_source %></td>
          <td class="px-4 py-3 text-slate-600">
            <%= vn_datetime(borrow.starts_at) %><br>
            <span class="text-xs text-slate-400">đến <%= vn_datetime(borrow.ends_at) %></span>
          </td>
          <td class="px-4 py-3"><%= status_badge(borrow.status_label, borrow.status_color) %></td>
          <td class="px-4 py-3">
            <div class="flex flex-wrap gap-2">
              <%= link_to "Xem", borrow_path(borrow), class: "rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50" %>
              <% if current_user.admin? || borrow.created_by == current_user %>
                <%= link_to "Sửa", edit_borrow_path(borrow), class: "rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50" %>
              <% end %>
              <% if borrow.returned_at.nil? && (current_user.admin? || borrow.created_by == current_user) %>
                <%= button_to "Xác nhận trả", confirm_return_borrow_path(borrow), method: :patch, class: "rounded-xl bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-emerald-700" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @borrows.empty? %>
        <tr>
          <td colspan="6" class="px-4 py-12 text-center text-slate-500">Chưa có phiếu mượn phù hợp.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
