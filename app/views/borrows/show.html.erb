<% content_for :title, "Phiếu mượn ##{@borrow.id}" %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center gap-2 text-sm text-gray-500">
    <%= link_to "Mượn – Trả", borrows_path, class: "hover:text-indigo-400 transition-colors" %>
    <span>›</span>
    <span class="text-gray-300">Phiếu #MT-<%= @borrow.id.to_s.rjust(8, "0") %></span>
  </div>

  <div class="bg-[#1a1d2e] card-glow rounded-2xl p-6 space-y-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-xl font-bold text-white">Chi tiết phiếu mượn</h1>
        <p class="text-gray-500 text-sm mt-1">Thông tin thiết bị và người mượn</p>
      </div>
      <%= status_badge(@borrow.status_label, @borrow.status_color) %>
    </div>

    <div class="grid grid-cols-2 gap-5 text-sm">
      <div class="bg-[#0f1117] rounded-xl p-4 border border-white/5">
        <p class="text-gray-500 text-xs uppercase tracking-wider mb-3">Thiết bị</p>
        <p class="text-white font-semibold"><%= @borrow.device.name %></p>
        <p class="text-gray-400 mt-1"><%= @borrow.device.code %></p>
        <p class="text-gray-500 mt-2"><%= @borrow.device.room %> · <%= @borrow.device.device_type %></p>
      </div>

      <div class="bg-[#0f1117] rounded-xl p-4 border border-white/5">
        <p class="text-gray-500 text-xs uppercase tracking-wider mb-3">Người mượn</p>
        <p class="text-white font-semibold"><%= @borrow.borrower_name %></p>
        <p class="text-gray-400 mt-1"><%= @borrow.borrower_class %></p>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-5 text-sm">
      <div>
        <p class="text-gray-500 mb-1">Ngày mượn</p>
        <p class="text-white"><%= vn_datetime(@borrow.borrowed_at) %></p>
      </div>
      <div>
        <p class="text-gray-500 mb-1">Hạn trả</p>
        <p class="text-white"><%= vn_date(@borrow.due_at) %></p>
      </div>
      <div>
        <p class="text-gray-500 mb-1">Ngày trả</p>
        <p class="text-white"><%= vn_datetime(@borrow.returned_at) %></p>
      </div>
      <div>
        <p class="text-gray-500 mb-1">Quá hạn</p>
        <p class="text-white"><%= @borrow.overdue? ? "#{@borrow.days_overdue} ngày" : "Không" %></p>
      </div>
    </div>

    <% if @borrow.purpose.present? || @borrow.notes.present? %>
      <div class="space-y-4">
        <% if @borrow.purpose.present? %>
          <div>
            <p class="text-gray-500 text-sm mb-1">Mục đích sử dụng</p>
            <p class="text-gray-300 text-sm"><%= @borrow.purpose %></p>
          </div>
        <% end %>

        <% if @borrow.notes.present? %>
          <div>
            <p class="text-gray-500 text-sm mb-1">Ghi chú</p>
            <p class="text-gray-300 text-sm"><%= @borrow.notes %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="flex gap-3 pt-2">
      <%= link_to "Quay lại", borrows_path, class: "flex-1 border border-white/10 text-gray-300 text-sm py-2.5 rounded-lg hover:bg-white/5 transition-colors text-center" %>
      <%= link_to "Chỉnh sửa", edit_borrow_path(@borrow), class: "flex-1 bg-indigo-600 hover:bg-indigo-500 text-white text-sm py-2.5 rounded-lg font-medium transition-colors text-center" %>
    </div>
  </div>
</div>
