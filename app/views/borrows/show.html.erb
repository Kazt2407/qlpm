<% content_for :title, "Phiếu mượn" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-6 flex items-start justify-between">
    <div>
      <p class="text-sm text-slate-500"><%= link_to "Lịch mượn và trả", borrows_path, class: "hover:text-[#124170]" %> / Phiếu #BR-<%= @borrow.id.to_s.rjust(5, "0") %></p>
      <h1 class="mt-3 text-3xl font-extrabold text-slate-900">Chi tiết phiếu mượn</h1>
    </div>
    <%= status_badge(@borrow.status_label, @borrow.status_color) %>
  </div>

  <div class="shell-card rounded-3xl border border-slate-200/70 p-6">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl bg-slate-50 p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Asset</p>
        <p class="mt-3 text-lg font-bold text-slate-900"><%= @borrow.asset.name %></p>
        <p class="mt-1 text-sm text-slate-500"><%= @borrow.asset.code %> · <%= @borrow.asset.asset_type_label %></p>
      </div>
      <div class="rounded-2xl bg-slate-50 p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Borrower</p>
        <p class="mt-3 text-lg font-bold text-slate-900"><%= @borrow.borrower_name %></p>
        <p class="mt-1 text-sm text-slate-500"><%= @borrow.borrower_group.presence || @borrow.borrower_type %></p>
      </div>
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
      <div>
        <p class="text-sm text-slate-500">Nguồn tạo</p>
        <p class="mt-1 font-medium text-slate-900"><%= @borrow.borrow_source %></p>
      </div>
      <div>
        <p class="text-sm text-slate-500">Workflow</p>
        <p class="mt-1 font-medium text-slate-900"><%= @borrow.workflow_state %></p>
      </div>
      <div>
        <p class="text-sm text-slate-500">Bắt đầu</p>
        <p class="mt-1 font-medium text-slate-900"><%= vn_datetime(@borrow.starts_at) %></p>
      </div>
      <div>
        <p class="text-sm text-slate-500">Kết thúc</p>
        <p class="mt-1 font-medium text-slate-900"><%= vn_datetime(@borrow.ends_at) %></p>
      </div>
      <div>
        <p class="text-sm text-slate-500">Đã trả lúc</p>
        <p class="mt-1 font-medium text-slate-900"><%= vn_datetime(@borrow.returned_at) %></p>
      </div>
      <div>
        <p class="text-sm text-slate-500">Quá hạn</p>
        <p class="mt-1 font-medium text-slate-900"><%= @borrow.overdue? ? "#{@borrow.days_overdue} ngày" : "Không" %></p>
      </div>
    </div>

    <% if @borrow.purpose.present? || @borrow.notes.present? %>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        <% if @borrow.purpose.present? %>
          <div class="rounded-2xl border border-slate-200 p-4">
            <p class="text-sm font-medium text-slate-700">Mục đích</p>
            <p class="mt-2 text-sm text-slate-600"><%= @borrow.purpose %></p>
          </div>
        <% end %>
        <% if @borrow.notes.present? %>
          <div class="rounded-2xl border border-slate-200 p-4">
            <p class="text-sm font-medium text-slate-700">Ghi chú</p>
            <p class="mt-2 text-sm text-slate-600"><%= @borrow.notes %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-6 flex gap-3">
      <%= link_to "Quay lại", borrows_path, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50" %>
      <% if current_user.admin? || @borrow.created_by == current_user %>
        <%= link_to "Chỉnh sửa", edit_borrow_path(@borrow), class: "rounded-2xl bg-[#124170] px-4 py-3 text-sm font-semibold text-white hover:bg-[#0d3258]" %>
      <% end %>
    </div>
  </div>
</div>
