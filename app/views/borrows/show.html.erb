<% content_for :title, "Phiếu mượn" %>
<%
  is_requester = requester_user?
  is_approver = current_user.approver?
  role_context = if is_approver
    "Màn hình xử lý dành cho người duyệt"
  elsif is_requester
    "Màn hình theo dõi dành cho #{current_user.user_type_label.downcase}"
  else
    "Màn hình quản trị phiếu mượn"
  end
%>

<div class="mx-auto max-w-4xl">
  <div class="mb-6 rounded-3xl border border-slate-200/70 bg-gradient-to-r from-slate-900 to-slate-700 p-6 text-white shell-card">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-slate-200"><%= role_context %></p>
        <h1 class="mt-2 text-3xl font-extrabold">Phiếu #BR-<%= @borrow.id.to_s.rjust(5, "0") %></h1>
        <p class="mt-2 text-sm text-slate-200">Xem thông tin chi tiết, lịch mượn trả và trạng thái xử lý hiện tại.</p>
      </div>
      <div class="space-y-2">
        <%= status_badge(@borrow.status_label, @borrow.status_color) %>
        <%= status_badge(@borrow.workflow_state_label, @borrow.workflow_state == "pending" ? "sky" : "gray") %>
      </div>
    </div>
  </div>

  <div class="shell-card rounded-3xl border border-slate-200/70 p-6">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl bg-slate-50 p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Đối tượng</p>
        <p class="mt-3 text-lg font-bold text-slate-900"><%= @borrow.asset.name %></p>
        <p class="mt-1 text-sm text-slate-500"><%= @borrow.asset.code %> · <%= @borrow.asset.asset_type_label %></p>
      </div>
      <div class="rounded-2xl bg-slate-50 p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Người mượn</p>
        <p class="mt-3 text-lg font-bold text-slate-900"><%= @borrow.borrower_name %></p>
        <p class="mt-1 text-sm text-slate-500"><%= @borrow.borrower_group.presence || @borrow.borrower_type_label %></p>
      </div>
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
      <div>
        <p class="text-sm text-slate-500">Nguồn tạo</p>
        <p class="mt-1 font-medium text-slate-900"><%= @borrow.borrow_source_label %></p>
      </div>
      <div>
        <p class="text-sm text-slate-500">Trạng thái xử lý</p>
        <p class="mt-1 font-medium text-slate-900"><%= @borrow.workflow_state_label %></p>
      </div>
      <div>
        <p class="text-sm text-slate-500">Bắt đầu</p>
        <p class="mt-1 font-medium text-slate-900"><%= vn_datetime(@borrow.starts_at) %></p>
      </div>
      <div>
        <p class="text-sm text-slate-500">Kết thúc</p>
        <p class="mt-1 font-medium text-slate-900"><%= vn_datetime(@borrow.ends_at) %></p>
      </div>
      <div>
        <p class="text-sm text-slate-500">Đã trả lúc</p>
        <p class="mt-1 font-medium text-slate-900"><%= vn_datetime(@borrow.returned_at) %></p>
      </div>
      <div>
        <p class="text-sm text-slate-500">Quá hạn</p>
        <p class="mt-1 font-medium text-slate-900"><%= @borrow.overdue? ? "#{@borrow.days_overdue} ngày" : "Không" %></p>
      </div>
    </div>

    <% if @borrow.purpose.present? || @borrow.notes.present? %>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        <% if @borrow.purpose.present? %>
          <div class="rounded-2xl border border-slate-200 p-4">
            <p class="text-sm font-medium text-slate-700">Mục đích</p>
            <p class="mt-2 text-sm text-slate-600"><%= @borrow.purpose %></p>
          </div>
        <% end %>
        <% if @borrow.notes.present? %>
          <div class="rounded-2xl border border-slate-200 p-4">
            <p class="text-sm font-medium text-slate-700">Ghi chú</p>
            <p class="mt-2 text-sm text-slate-600"><%= @borrow.notes %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to "Quay lại", borrows_path, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50" %>

      <% if can_manage_system? %>
        <%= link_to "Chỉnh sửa", edit_borrow_path(@borrow), class: "rounded-2xl bg-[#124170] px-4 py-3 text-sm font-semibold text-white hover:bg-[#0d3258]" %>
      <% end %>

      <% if can_review_borrows? && @borrow.can_approve? %>
        <%= button_to "Duyệt phiếu", approve_borrow_path(@borrow), method: :patch, class: "rounded-2xl bg-sky-600 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-700" %>
      <% end %>

      <% if can_review_borrows? && @borrow.can_reject? %>
        <%= button_to "Từ chối", reject_borrow_path(@borrow), method: :patch, class: "rounded-2xl bg-rose-600 px-4 py-3 text-sm font-semibold text-white hover:bg-rose-700" %>
      <% end %>

      <% if can_review_borrows? && @borrow.returned_at.nil? %>
        <%= button_to "Xác nhận đã trả", confirm_return_borrow_path(@borrow), method: :patch, class: "rounded-2xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white hover:bg-emerald-700" %>
      <% end %>
    </div>
  </div>
</div>
