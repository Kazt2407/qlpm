<% content_for :title, "Cập nhật phiếu mượn" %>

<div class="mx-auto max-w-5xl">
  <div class="mb-6">
    <h1 class="text-3xl font-extrabold text-slate-900">Cập nhật phiếu #BR-<%= @borrow.id.to_s.rjust(5, "0") %></h1>
    <p class="mt-2 text-sm text-slate-500">Điều chỉnh trạng thái, thời gian, hoặc người mượn cho phiếu hiện tại.</p>
  </div>
  <div class="shell-card rounded-3xl border border-slate-200/70 p-6">
    <%= render "form", borrow: @borrow %>
  </div>
</div>
