<% content_for :title, "Sửa phiếu mượn ##{@borrow.id}" %>

<div class="max-w-2xl mx-auto">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <%= link_to "Mượn – Trả", borrows_path, class: "hover:text-indigo-400 transition-colors" %>
    <span>›</span>
    <%= link_to "Phiếu ##{@borrow.id}", borrow_path(@borrow), class: "hover:text-indigo-400 transition-colors" %>
    <span>›</span>
    <span class="text-gray-300">Chỉnh sửa</span>
  </div>

  <div class="bg-[#1a1d2e] card-glow rounded-2xl p-6">
    <h1 class="text-xl font-bold text-white mb-6">Cập nhật phiếu mượn</h1>
    <%= render "form", borrow: @borrow, available_devices: @available_devices %>
  </div>
</div>
