<%
  is_system_editor = can_manage_system?
  is_requester = requester_user?
%>

<%= form_with model: borrow, class: "space-y-6", data: { borrow_form: true } do |f| %>
  <% if borrow.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <% borrow.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <% if is_requester %>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
      Phiếu sẽ gắn tự động cho <span class="font-semibold"><%= current_user.full_name %></span> · <%= current_user.user_type_label %>.
    </div>
  <% end %>

  <div class="grid gap-5 md:grid-cols-2">
    <div class="md:col-span-2">
      <%= f.label :asset_id, "Đối tượng sử dụng", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.select :asset_id, @available_assets.map { |asset| ["#{asset.code} - #{asset.name}", asset.id] }, { include_blank: "Chọn đối tượng" }, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      <% if borrow.errors[:asset_id].any? %>
        <p class="mt-1 text-sm text-red-600"><%= borrow.errors[:asset_id].to_sentence %></p>
        <p class="mt-1 text-xs text-amber-700">Gợi ý: đổi khung giờ hoặc chọn đối tượng khác để tránh trùng lịch.</p>
      <% end %>
    </div>

    <div>
      <%= f.label :starts_at, "Bắt đầu", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.datetime_local_field :starts_at, value: borrow.starts_at&.strftime("%Y-%m-%dT%H:%M"), class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm", data: { start_field: true } %>
      <% if borrow.errors[:starts_at].any? %>
        <p class="mt-1 text-sm text-red-600"><%= borrow.errors[:starts_at].to_sentence %></p>
      <% end %>
    </div>

    <div>
      <%= f.label :ends_at, "Kết thúc", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.datetime_local_field :ends_at, value: borrow.ends_at&.strftime("%Y-%m-%dT%H:%M"), class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm", data: { end_field: true } %>
      <% if borrow.errors[:ends_at].any? %>
        <p class="mt-1 text-sm text-red-600"><%= borrow.errors[:ends_at].to_sentence %></p>
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Khung nhanh</p>
    <div class="mt-2 flex flex-wrap gap-2">
      <button type="button" data-duration-minutes="60" class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-white">+1 giờ</button>
      <button type="button" data-duration-minutes="120" class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-white">+2 giờ</button>
      <button type="button" data-duration-minutes="240" class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-white">+Nửa ngày</button>
    </div>
  </div>

  <% if is_system_editor %>
    <div class="grid gap-5 md:grid-cols-2">
      <div>
        <%= f.label :borrow_source, "Nguồn tạo", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.select :borrow_source, Borrow.source_options, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
      <div>
        <%= f.label :borrower_type, "Nhóm người mượn", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.select :borrower_type, Borrow.borrower_type_options, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      <div>
        <%= f.label :borrower_name, "Tên người mượn", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :borrower_name, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
        <% if borrow.errors[:borrower_name].any? %>
          <p class="mt-1 text-sm text-red-600"><%= borrow.errors[:borrower_name].to_sentence %></p>
        <% end %>
      </div>
      <div>
        <%= f.label :borrower_identifier, "Mã định danh", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :borrower_identifier, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
      <div>
        <%= f.label :borrower_group, "Lớp / bộ môn", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :borrower_group, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <div>
        <%= f.label :approved_by_id, "Người duyệt", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.select :approved_by_id, @approvers.map { |user| [user.full_name, user.id] }, { include_blank: "Chọn người duyệt" }, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
      <div>
        <%= f.label :workflow_state, "Trạng thái xử lý", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.select :workflow_state, Borrow.workflow_state_options, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :purpose, "Mục đích", class: "mb-2 block text-sm font-medium text-slate-700" %>
    <%= f.text_area :purpose, rows: 3, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm", placeholder: "Ví dụ: dạy thực hành tiết 3, kiểm tra cấu hình máy..." %>
  </div>

  <div>
    <%= f.label :notes, "Ghi chú", class: "mb-2 block text-sm font-medium text-slate-700" %>
    <%= f.text_area :notes, rows: 3, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm", placeholder: "Thông tin bổ sung nếu cần" %>
  </div>

  <div class="flex gap-3">
    <%= link_to "Hủy", borrows_path, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50" %>
    <%= f.submit borrow.persisted? ? "Cập nhật phiếu" : "Gửi yêu cầu", class: "rounded-2xl bg-[#124170] px-4 py-3 text-sm font-semibold text-white hover:bg-[#0d3258]" %>
  </div>
<% end %>

<script>
  (() => {
    const form = document.querySelector('[data-borrow-form="true"]');
    if (!form) return;

    const startField = form.querySelector('[data-start-field="true"]');
    const endField = form.querySelector('[data-end-field="true"]');
    if (!startField || !endField) return;

    form.querySelectorAll('[data-duration-minutes]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!startField.value) return;
        const startDate = new Date(startField.value);
        const minutes = parseInt(button.dataset.durationMinutes, 10);
        if (Number.isNaN(startDate.getTime()) || Number.isNaN(minutes)) return;

        const endDate = new Date(startDate.getTime() + minutes * 60 * 1000);
        const timezoneOffset = endDate.getTimezoneOffset() * 60 * 1000;
        const localDate = new Date(endDate.getTime() - timezoneOffset);
        endField.value = localDate.toISOString().slice(0, 16);
      });
    });
  })();
</script>
