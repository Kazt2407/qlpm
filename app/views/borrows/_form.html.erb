<%= form_with model: borrow, class: "space-y-5" do |f| %>
  <% if borrow.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <% borrow.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :asset_id, "Đối tượng sử dụng", class: "mb-2 block text-sm font-medium text-slate-700" %>
    <%= f.select :asset_id, @available_assets.map { |asset| ["#{asset.code} - #{asset.name}", asset.id] }, { include_blank: "Chọn asset" }, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
  </div>

  <% if current_user.admin? %>
    <div class="grid gap-5 md:grid-cols-2">
      <div>
        <%= f.label :borrow_source, "Nguồn tạo", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.select :borrow_source, Borrow::SOURCES, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
      <div>
        <%= f.label :borrower_type, "Nhóm người mượn", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.select :borrower_type, Borrow::BORROWER_TYPES, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      <div>
        <%= f.label :borrower_name, "Tên người mượn", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :borrower_name, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
      <div>
        <%= f.label :borrower_identifier, "Mã định danh", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :borrower_identifier, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
      <div>
        <%= f.label :borrower_group, "Lớp / bộ môn", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :borrower_group, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">
      Yêu cầu sẽ tự gắn với tài khoản hiện tại: <span class="font-semibold text-slate-900"><%= current_user.full_name %></span>.
    </div>
  <% end %>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= f.label :starts_at, "Bắt đầu", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.datetime_local_field :starts_at, value: borrow.starts_at&.strftime("%Y-%m-%dT%H:%M"), class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
    <div>
      <%= f.label :ends_at, "Kết thúc", class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.datetime_local_field :ends_at, value: borrow.ends_at&.strftime("%Y-%m-%dT%H:%M"), class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
    </div>
  </div>

  <% if current_user.admin? %>
    <div class="grid gap-5 md:grid-cols-2">
      <div>
        <%= f.label :approved_by_id, "Người duyệt", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.select :approved_by_id, @approvers.map { |user| [user.full_name, user.id] }, { include_blank: "Chọn admin duyệt" }, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
      <div>
        <%= f.label :workflow_state, "Workflow", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.select :workflow_state, Borrow::WORKFLOW_STATES, {}, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :purpose, "Mục đích", class: "mb-2 block text-sm font-medium text-slate-700" %>
    <%= f.text_area :purpose, rows: 3, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
  </div>

  <div>
    <%= f.label :notes, "Ghi chú", class: "mb-2 block text-sm font-medium text-slate-700" %>
    <%= f.text_area :notes, rows: 3, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
  </div>

  <div class="flex gap-3">
    <%= link_to "Hủy", borrows_path, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50" %>
    <%= f.submit borrow.persisted? ? "Cập nhật phiếu" : "Tạo phiếu", class: "rounded-2xl bg-[#124170] px-4 py-3 text-sm font-semibold text-white hover:bg-[#0d3258]" %>
  </div>
<% end %>
