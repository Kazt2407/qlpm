<% content_for :title, "Báo cáo" %>

<div class="mb-8 flex items-start justify-between">
  <div>
    <h1 class="text-3xl font-extrabold text-slate-900">Báo cáo vận hành</h1>
    <p class="mt-2 text-sm text-slate-500">Theo dõi hiệu suất mượn trả theo tháng, nguồn tạo, và nhóm người dùng.</p>
  </div>
  <div class="flex gap-3">
    <%= form_with url: reports_path, method: :get, class: "flex gap-3" do |f| %>
      <%= f.select :month, @available_months.map { |m| [m.strftime("Tháng %m/%Y"), m.strftime("%Y-%m-01")] }, { selected: @month.strftime("%Y-%m-01") }, class: "rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      <%= f.submit "Xem", class: "rounded-2xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white" %>
    <% end %>
    <%= link_to "Tải báo cáo CSV", export_reports_path(month: @month.strftime("%Y-%m-01")), class: "rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  </div>
</div>

<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
  <% [["Tổng lượt mượn", @total_borrows], ["Trả đúng hạn", "#{@on_time_return_pct}%"], ["Phòng đang dùng", @rooms_in_use], ["Cần xử lý", @under_repair]].each do |label, value| %>
    <div class="shell-card rounded-3xl border border-slate-200/70 p-5">
      <p class="text-sm text-slate-500"><%= label %></p>
      <p class="mt-4 text-4xl font-extrabold text-slate-900"><%= value %></p>
    </div>
  <% end %>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <div class="shell-card rounded-3xl border border-slate-200/70 p-6">
    <h2 class="text-lg font-bold text-slate-900">Xu hướng 7 tháng</h2>
    <div class="mt-6 flex h-56 items-end gap-4">
      <% max_value = [@monthly_trend.map { |row| row[:count] }.max, 1].max %>
      <% @monthly_trend.each do |row| %>
        <div class="flex flex-1 flex-col items-center gap-2">
          <div class="w-full rounded-t-2xl bg-gradient-to-t from-[#124170] to-[#72b3de]" style="height: <%= [row[:count].to_f / max_value * 100, 8].max %>%"></div>
          <p class="text-xs font-semibold text-slate-700"><%= row[:count] %></p>
          <p class="text-xs text-slate-500"><%= row[:month] %></p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="shell-card rounded-3xl border border-slate-200/70 p-6">
    <h2 class="text-lg font-bold text-slate-900">Mức sẵn sàng theo loại đối tượng</h2>
    <div class="mt-6 space-y-4">
      <% @assets_by_type.each do |row| %>
        <div>
          <div class="mb-2 flex items-center justify-between text-sm">
            <span class="font-medium text-slate-700"><%= Asset.asset_type_label_for(row[:type]) %></span>
            <span class="text-slate-500"><%= row[:pct] %>%</span>
          </div>
          <div class="h-3 rounded-full bg-slate-100">
            <div class="h-3 rounded-full bg-gradient-to-r from-[#124170] to-[#5ea3d6]" style="width: <%= row[:pct] %>%"></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-3">
  <div class="shell-card rounded-3xl border border-slate-200/70 p-6">
    <h2 class="text-lg font-bold text-slate-900">Nguồn tạo</h2>
    <div class="mt-5 space-y-3">
      <% @borrow_sources.each do |source, count| %>
        <div class="flex items-center justify-between rounded-2xl bg-slate-50 px-4 py-3">
          <span class="text-sm text-slate-600"><%= Borrow.source_label_for(source) %></span>
          <span class="font-semibold text-slate-900"><%= count %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="shell-card rounded-3xl border border-slate-200/70 p-6">
    <h2 class="text-lg font-bold text-slate-900">Nhóm người mượn</h2>
    <div class="mt-5 space-y-3">
      <% @borrower_mix.each do |kind, count| %>
        <div class="flex items-center justify-between rounded-2xl bg-slate-50 px-4 py-3">
          <span class="text-sm text-slate-600"><%= Borrow.borrower_type_label_for(kind) %></span>
          <span class="font-semibold text-slate-900"><%= count %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="shell-card rounded-3xl border border-slate-200/70 p-6">
    <h2 class="text-lg font-bold text-slate-900">Người mượn nhiều nhất</h2>
    <div class="mt-5 space-y-3">
      <% @top_borrowers.each do |(name, group), count| %>
        <div class="rounded-2xl bg-slate-50 px-4 py-3">
          <div class="flex items-center justify-between">
            <span class="font-medium text-slate-800"><%= name %></span>
            <span class="text-sm font-semibold text-[#124170]"><%= count %></span>
          </div>
          <p class="mt-1 text-xs text-slate-500"><%= group %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="shell-card mt-6 rounded-3xl border border-slate-200/70 p-6">
  <h2 class="text-lg font-bold text-slate-900">Đối tượng cần chú ý</h2>
  <div class="mt-5 overflow-hidden rounded-2xl border border-slate-200">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase tracking-[0.2em] text-slate-500">
        <tr>
          <th class="px-4 py-3">Đối tượng</th>
          <th class="px-4 py-3">Loại</th>
          <th class="px-4 py-3">Phòng</th>
          <th class="px-4 py-3">Trạng thái</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        <% @attention_assets.each do |asset| %>
          <tr>
            <td class="px-4 py-3">
              <div class="font-semibold text-slate-900"><%= asset.name %></div>
              <div class="text-xs text-slate-500"><%= asset.code %></div>
            </td>
            <td class="px-4 py-3 text-slate-600"><%= asset.asset_type_label %></td>
            <td class="px-4 py-3 text-slate-600"><%= asset.room_name || "–" %></td>
            <td class="px-4 py-3"><%= status_badge(asset.status_label, asset.status_color) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
