<% content_for :title, "Điều khiển theo phòng" %>

<div class="mb-6 rounded-3xl border border-slate-200/70 bg-gradient-to-r from-[#124170] to-[#3f7baa] p-6 text-white shell-card">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-3xl font-extrabold">Điều khiển theo phòng</h1>
      <p class="mt-1 text-sm text-white/85">Gửi lệnh nhanh đến toàn bộ host đang bật trong một phòng.</p>
    </div>
    <%= link_to "Danh sách host", veyon_hosts_path, class: "rounded-2xl border border-white/40 bg-white/10 px-4 py-2 text-sm font-semibold text-white" %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="shell-card rounded-3xl border border-slate-200/70 p-5">
    <%= form_with url: rooms_veyon_hosts_path, method: :get, class: "space-y-3" do |f| %>
      <%= f.select :room_id, @rooms.map { |room| [room.name, room.id] }, { selected: @selected_room&.id }, class: "w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm" %>
      <%= f.submit "Chọn phòng", class: "w-full rounded-2xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white" %>
    <% end %>

    <% if @selected_room %>
      <div class="mt-5 rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">
        <p class="font-semibold text-slate-900"><%= @selected_room.name %></p>
        <p class="mt-1"><%= @veyon_hosts.count %> host sẵn sàng nhận lệnh.</p>
      </div>
    <% end %>
  </section>

  <section class="shell-card rounded-3xl border border-slate-200/70 p-5 lg:col-span-2">
    <h2 class="text-lg font-bold text-slate-900">Lệnh theo phòng</h2>
    <% if @selected_room && @veyon_hosts.any? %>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        <% if @allowed_features.include?("screen_lock") %>
          <%= button_to "Khóa màn hình cả phòng", execute_room_feature_veyon_hosts_path, params: { room_id: @selected_room.id, feature_key: "screen_lock", active: true }, class: "w-full rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white" %>
          <%= button_to "Mở khóa cả phòng", execute_room_feature_veyon_hosts_path, params: { room_id: @selected_room.id, feature_key: "screen_lock", active: false }, class: "w-full rounded-xl border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700" %>
        <% end %>
        <% if @allowed_features.include?("text_message") %>
          <%= form_with url: execute_room_feature_veyon_hosts_path, method: :post, class: "space-y-2 md:col-span-2" do %>
            <%= hidden_field_tag :room_id, @selected_room.id %>
            <%= hidden_field_tag :feature_key, "text_message" %>
            <%= text_area_tag :text, nil, rows: 3, placeholder: "Tin nhắn gửi đến cả phòng...", class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" %>
            <%= submit_tag "Gửi tin nhắn cả phòng", class: "rounded-xl bg-sky-600 px-3 py-2 text-xs font-semibold text-white" %>
          <% end %>
        <% end %>
        <% if @allowed_features.include?("open_website") %>
          <%= form_with url: execute_room_feature_veyon_hosts_path, method: :post, class: "space-y-2 md:col-span-2" do %>
            <%= hidden_field_tag :room_id, @selected_room.id %>
            <%= hidden_field_tag :feature_key, "open_website" %>
            <%= text_field_tag :website_urls, nil, placeholder: "https://example.com", class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" %>
            <%= submit_tag "Mở website cả phòng", class: "rounded-xl bg-emerald-600 px-3 py-2 text-xs font-semibold text-white" %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="mt-4 rounded-2xl border border-dashed border-slate-200 p-8 text-center text-sm text-slate-500">Phòng này chưa có máy Veyon đang bật.</div>
    <% end %>
  </section>
</div>

<div class="shell-card mt-6 overflow-hidden rounded-3xl border border-slate-200/70">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-[0.2em] text-slate-500">
      <tr>
        <th class="px-4 py-3">Máy điều khiển</th>
        <th class="px-4 py-3">Đối tượng</th>
        <th class="px-4 py-3">Lần thấy gần nhất</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 bg-white">
      <% @veyon_hosts.each do |host| %>
        <tr>
          <td class="px-4 py-3"><%= link_to host.host, veyon_host_path(host), class: "font-semibold text-[#124170]" %></td>
          <td class="px-4 py-3"><%= host.asset.code %> - <%= host.asset.name %></td>
          <td class="px-4 py-3 text-slate-600"><%= vn_datetime(host.last_seen_at) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
