<% content_for :title, "Điều khiển #{ @veyon_host.host }" %>
<%
  feature_labels = {
    "screen_lock" => "Khóa màn hình",
    "input_devices_lock" => "Khóa chuột và bàn phím",
    "user_logoff" => "Đăng xuất",
    "reboot" => "Khởi động lại",
    "power_down" => "Tắt máy",
    "text_message" => "Gửi tin nhắn",
    "open_website" => "Mở trang web",
    "start_app" => "Mở ứng dụng"
  }
%>

<div class="mb-6 rounded-3xl border border-slate-200/70 bg-gradient-to-r from-[#124170] to-[#3f7baa] p-6 text-white shell-card">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-3xl font-extrabold"><%= @veyon_host.host %></h1>
      <p class="mt-1 text-sm text-white/85"><%= @veyon_host.asset.code %> · <%= @veyon_host.asset.name %></p>
    </div>
    <div class="flex gap-2">
      <%= button_to "Cập nhật trạng thái", refresh_status_veyon_host_path(@veyon_host), method: :post, class: "rounded-2xl border border-white/40 bg-white/10 px-4 py-2 text-sm font-semibold text-white" %>
      <%= link_to "Quay lại", veyon_hosts_path, class: "rounded-2xl border border-white/40 bg-white/10 px-4 py-2 text-sm font-semibold text-white" %>
    </div>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="shell-card rounded-3xl border border-slate-200/70 p-4 lg:col-span-2">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-bold text-slate-900">Màn hình trực tiếp</h2>
      <span class="text-xs text-slate-500">Tự làm mới mỗi <%= (AppSettings.veyon_framebuffer_poll_interval_ms / 1000.0).round(1) %> giây</span>
    </div>
    <img
      id="framebuffer-preview"
      src="<%= framebuffer_veyon_host_path(@veyon_host, t: Time.current.to_i) %>"
      alt="Live preview"
      class="w-full rounded-2xl border border-slate-200 bg-slate-100"
      loading="eager"
    />
  </section>

  <section class="shell-card rounded-3xl border border-slate-200/70 p-4">
    <h2 class="text-lg font-bold text-slate-900">Lệnh nhanh</h2>

    <div class="mt-4 space-y-3">
      <% if @allowed_features.include?("screen_lock") %>
        <div class="flex gap-2">
          <%= button_to "Khóa màn hình", execute_feature_veyon_host_path(@veyon_host), params: { feature_key: "screen_lock", active: true }, class: "flex-1 rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white" %>
          <%= button_to "Mở khóa", execute_feature_veyon_host_path(@veyon_host), params: { feature_key: "screen_lock", active: false }, class: "flex-1 rounded-xl border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700" %>
        </div>
      <% end %>

      <% if @allowed_features.include?("input_devices_lock") %>
        <div class="flex gap-2">
          <%= button_to "Khóa input", execute_feature_veyon_host_path(@veyon_host), params: { feature_key: "input_devices_lock", active: true }, class: "flex-1 rounded-xl bg-slate-900 px-3 py-2 text-xs font-semibold text-white" %>
          <%= button_to "Mở input", execute_feature_veyon_host_path(@veyon_host), params: { feature_key: "input_devices_lock", active: false }, class: "flex-1 rounded-xl border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700" %>
        </div>
      <% end %>

      <% if @allowed_features.include?("text_message") %>
        <%= form_with url: execute_feature_veyon_host_path(@veyon_host), method: :post, class: "space-y-2" do |f| %>
          <%= hidden_field_tag :feature_key, "text_message" %>
          <%= text_area_tag :text, nil, rows: 3, placeholder: "Nhập nội dung nhắn...", class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" %>
          <%= f.submit "Gửi tin nhắn", class: "w-full rounded-xl bg-sky-600 px-3 py-2 text-xs font-semibold text-white" %>
        <% end %>
      <% end %>

      <% if @allowed_features.include?("open_website") %>
        <%= form_with url: execute_feature_veyon_host_path(@veyon_host), method: :post, class: "space-y-2" do |f| %>
          <%= hidden_field_tag :feature_key, "open_website" %>
          <%= text_field_tag :website_urls, nil, placeholder: "https://example.com", class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" %>
          <%= f.submit "Mở trang web", class: "w-full rounded-xl bg-emerald-600 px-3 py-2 text-xs font-semibold text-white" %>
        <% end %>
      <% end %>

      <% if @allowed_features.include?("start_app") %>
        <%= form_with url: execute_feature_veyon_host_path(@veyon_host), method: :post, class: "space-y-2" do |f| %>
          <%= hidden_field_tag :feature_key, "start_app" %>
          <%= text_field_tag :applications, nil, placeholder: "notepad.exe", class: "w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" %>
          <%= f.submit "Mở ứng dụng", class: "w-full rounded-xl bg-amber-600 px-3 py-2 text-xs font-semibold text-white" %>
        <% end %>
      <% end %>

      <% if @allowed_features.include?("user_logoff") %>
        <%= button_to "Đăng xuất người dùng", execute_feature_veyon_host_path(@veyon_host), params: { feature_key: "user_logoff" }, class: "w-full rounded-xl bg-rose-600 px-3 py-2 text-xs font-semibold text-white" %>
      <% end %>

      <% if @allowed_features.include?("reboot") %>
        <%= button_to "Khởi động lại", execute_feature_veyon_host_path(@veyon_host), params: { feature_key: "reboot" }, class: "w-full rounded-xl bg-slate-800 px-3 py-2 text-xs font-semibold text-white" %>
      <% end %>

      <% if @allowed_features.include?("power_down") %>
        <%= button_to "Tắt máy", execute_feature_veyon_host_path(@veyon_host), params: { feature_key: "power_down" }, class: "w-full rounded-xl bg-black px-3 py-2 text-xs font-semibold text-white" %>
      <% end %>
    </div>
  </section>
</div>

<div class="shell-card mt-6 overflow-hidden rounded-3xl border border-slate-200/70">
  <div class="border-b border-slate-200 px-4 py-3">
    <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Lịch sử lệnh gần nhất</h2>
  </div>
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-[0.2em] text-slate-500">
      <tr>
        <th class="px-4 py-3">Thời gian</th>
        <th class="px-4 py-3">Người thao tác</th>
        <th class="px-4 py-3">Lệnh</th>
        <th class="px-4 py-3">Kết quả</th>
        <th class="px-4 py-3">Lỗi</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 bg-white">
      <% @recent_actions.each do |action| %>
        <tr>
          <td class="px-4 py-3 text-slate-600"><%= vn_datetime(action.created_at) %></td>
          <td class="px-4 py-3 text-slate-800"><%= action.user.full_name %></td>
          <td class="px-4 py-3 text-slate-700"><%= feature_labels[action.feature_key] || action.feature_key %></td>
          <td class="px-4 py-3"><%= status_badge(action.status, action.success? ? "emerald" : action.status == "failed" ? "red" : "sky") %></td>
          <td class="px-4 py-3 text-slate-600"><%= action.error_message.presence || "–" %></td>
        </tr>
      <% end %>

      <% if @recent_actions.empty? %>
        <tr>
          <td colspan="5" class="px-4 py-8 text-center text-slate-500">Chưa có lệnh nào được ghi nhận.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
  (function () {
    const refreshInterval = <%= AppSettings.veyon_framebuffer_poll_interval_ms %>;
    const image = document.getElementById("framebuffer-preview");
    if (!image || refreshInterval <= 0) return;

    setInterval(function () {
      const baseUrl = "<%= framebuffer_veyon_host_path(@veyon_host) %>";
      image.src = baseUrl + "?t=" + Date.now();
    }, refreshInterval);
  })();
</script>
