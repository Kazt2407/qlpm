# Bundler and local tool state
/.bundle
/vendor/bundle

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# SQLite databases and local storage
/storage/*.sqlite3
/storage/*.sqlite3-*
/db/*.sqlite3
/db/*.sqlite3-*

# Local environment/editor files
/.codex
/.DS_Store
.env
.env.*
!.env.example

# Generated report artifacts and local analysis output
/.understand-anything/
/diagrams/
/output/
/screenshots/
/skills/
/codebase_report.md
/report_analysis.json
/*_website_report_*.md
/*_website_report_*.docx
/thuongmaidientu_report_*.md
/thuongmaidientu_report_*.docx
/website_codebase_report_*.md
/website_codebase_report_*.docx

# Local secrets mounted into containers
/secrets/*
!/secrets/.keep
