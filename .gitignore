# Bundler and local tool state
/.bundle
/vendor/bundle

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# SQLite databases and local storage
/storage/*.sqlite3
/storage/*.sqlite3-*
/db/*.sqlite3
/db/*.sqlite3-*

# Local environment/editor files
/.codex
/.DS_Store
.env
.env.*
!.env.example

# Local secrets mounted into containers
/secrets/*
!/secrets/.keep
