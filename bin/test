#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir(APP_ROOT) do
  puts "==> Running QLPM test suite in Docker"
  system!("docker", "compose", "run", "--rm", "test")
end
