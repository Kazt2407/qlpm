# Rails
RAILS_ENV=development
RAILS_MAX_THREADS=5
APP_HOST=localhost
APP_PORT=3000
ADMINER_PORT=8080
PHPMYADMIN_PORT=8081

# Database (MySQL)
# For Docker Compose, the app connects to the mysql service with qlpm/qlpm.
# For native host Rails, set DB_HOST=127.0.0.1 and match your local MySQL user.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=qlpm
DB_PASSWORD=qlpm
DB_ROOT_PASSWORD=root
DB_TIMEOUT=5000
DB_NAME=qlpm
DB_TEST_NAME=qlpm_test

# App behavior
APP_PAGINATION_DEFAULT_PER_PAGE=15
APP_PAGINATION_MAX_PER_PAGE=100
APP_PAGINATION_OPTIONS=15,30,50
APP_BORROW_DEFAULT_DURATION_MINUTES=120
APP_REPORT_TOP_BORROWERS_LIMIT=5
APP_REPORT_ATTENTION_ASSETS_LIMIT=5
APP_REPORT_MONTHS_LOOKBACK=12

# Mail
MAIL_FROM=qlpm@example.local
MAIL_DELIVERY_METHOD=file
SMTP_ADDRESS=localhost
SMTP_PORT=25
SMTP_DOMAIN=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false

# Veyon integration
VEYON_ENABLED=false
VEYON_GATEWAY_BASE_URL=http://veyon-gateway:8088
VEYON_GATEWAY_API_KEY=change-me
VEYON_FRAMEBUFFER_FORMAT=jpeg
VEYON_FRAMEBUFFER_WIDTH=360
VEYON_FRAMEBUFFER_HEIGHT=0
VEYON_FRAMEBUFFER_JPEG_QUALITY=60
VEYON_FRAMEBUFFER_POLL_INTERVAL_MS=2000
VEYON_ALLOWED_FEATURES_ADMIN=screen_lock,input_devices_lock,user_logoff,reboot,power_down,text_message,open_website,start_app
VEYON_ALLOWED_FEATURES_APPROVER=screen_lock,input_devices_lock,user_logoff,text_message,open_website,start_app

# Veyon gateway service
GATEWAY_PORT=8088
VEYON_GATEWAY_FORWARD_PORT=8088
# WebAPI Proxy endpoint used by the Docker gateway. This is not the Windows client port.
# docker-compose.yml maps host.docker.internal to the Docker host for Linux compatibility.
VEYON_WEBAPI_BASE_URL=http://host.docker.internal:11080
VEYON_DEFAULT_AUTH_METHOD=auth_keys
VEYON_AUTH_USERNAME=
VEYON_AUTH_PASSWORD=
VEYON_AUTH_SIMPLE_PASSWORD=
VEYON_AUTH_KEYNAME=your-key-name
VEYON_AUTH_KEYDATA=
VEYON_AUTH_KEYDATA_FILE=/run/secrets/veyon-auth-key.pem
VEYON_WEBAPI_INSECURE_SKIP_TLS_VERIFY=false
GATEWAY_REQUEST_TIMEOUT_MS=15000
GATEWAY_CLEANUP_INTERVAL_MS=30000
